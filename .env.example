# Firebase (ใส่ค่าจาก Firebase Console → Project Settings → Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# หมายเหตุ: ไม่ต้องการ VITE_ANTHROPIC_API_KEY อีกต่อไป
# PDF อ่านด้วย pdfjs-dist ฟรี 100% ไม่ต้องการ API ภายนอก

# Gmail Notification — ตั้งค่าใน GitHub Repository Secrets (ไม่ใส่ใน .env)
# GMAIL_USER=your@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# วิธีสร้าง App Password: myaccount.google.com → Security → 2-Step Verification → App Passwords
